---
import { hero } from '@/data/home';

/**
 * "About the operator" — bio paragraphs from home.ts. Sits between
 * the SystemStrip and the Stats HUD. Uses a side rule + mono kicker
 * pattern instead of a HudCard so it reads as prose, not a widget.
 */
---

<section
  id="about"
  aria-labelledby="about-title"
  class="relative mx-auto mt-24 max-w-6xl px-6"
>
  <div class="grid gap-10 md:grid-cols-[auto_1fr] md:gap-16">
    <div class="md:sticky md:top-24 md:self-start">
      <p
        class="font-mono text-[10px] uppercase tracking-[0.4em] text-primary/70"
      >
        // 0001
      </p>
      <h2
        id="about-title"
        class="mt-3 font-heading text-2xl font-bold uppercase tracking-wider text-foreground md:text-3xl"
      >
        About the<br />Operator
      </h2>
      <div class="mt-4 flex gap-1">
        <div class="h-px w-12 bg-primary/70"></div>
        <div class="h-px w-6 bg-primary/40"></div>
        <div class="h-px w-2 bg-primary/20"></div>
      </div>
    </div>

    <div class="space-y-5 border-l border-primary/15 pl-6 md:pl-10">
      {
        hero.bio.map((paragraph) => (
          <p class="text-base leading-relaxed text-foreground/70 md:text-lg">
            {paragraph}
          </p>
        ))
      }
      <p class="font-mono text-[10px] uppercase tracking-widest text-primary/60">
        — End transmission segment
      </p>
    </div>
  </div>
</section>
