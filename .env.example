# Copy to .env for local dev. .env is gitignored.

# Base URL used for canonical, OG, sitemap, and RSS.
# Local dev:
SITE_URL=http://localhost:4321
# On Cloudflare Pages this is derived automatically from CF_PAGES_URL
# + CF_PAGES_BRANCH, so leave it unset there.

# Cloudflare Web Analytics beacon token (Pages → Settings → Analytics).
# Leave unset locally to skip the beacon script.
PUBLIC_CF_ANALYTICS_TOKEN=
