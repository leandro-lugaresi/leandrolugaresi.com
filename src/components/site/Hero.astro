---
import PerspectiveGrid from '@/components/site/PerspectiveGrid.astro';
import { hero, social } from '@/data/home';

/**
 * Full-bleed landing hero. Inspired by the gridcn home page hero
 * (educlopez/thegridcn-ui app/page.tsx) but rewritten as static
 * SSR with a CSS perspective grid in place of Three.js Grid3D.
 *
 * All copy comes from src/data/home.ts.
 */

// Split the full name on the first space — first word stacks above,
// the rest gets the bigger primary-amber treatment.
const [firstName, ...rest] = hero.name.split(' ');
const lastName = rest.join(' ');

const githubLink = social.find((s) => s.label === 'GitHub')?.href ?? '#';
---

<section
  class="relative isolate flex min-h-[88vh] w-full items-center justify-center overflow-hidden"
>
  <PerspectiveGrid />

  <!-- thin uplink bar at the very top of the hero -->
  <div
    class="absolute inset-x-0 top-0 z-20 border-b border-primary/15 bg-background/40 backdrop-blur-sm"
  >
    <div
      class="mx-auto flex max-w-6xl items-center justify-between px-6 py-1.5 font-mono text-[9px] uppercase tracking-widest text-foreground/40"
    >
      <span>UPLINK · leandrolugaresi.com.br</span>
      <span class="hidden sm:inline">SECTOR · backend &middot; systems &middot; go</span>
      <span class="text-primary/70">STATUS · ONLINE</span>
    </div>
  </div>

  <!-- main centered content with outer scanning frame -->
  <div class="relative z-10 mx-auto max-w-5xl px-6 py-20 md:py-28">
    <div class="relative">
      <!-- outer scanning frame -->
      <div aria-hidden="true" class="absolute -inset-6 md:-inset-10">
        <div class="absolute inset-0 border border-primary/20"></div>

        <!-- thicker corner brackets -->
        <div class="absolute -left-1 -top-1 h-10 w-10 border-l-2 border-t-2 border-primary"></div>
        <div class="absolute -right-1 -top-1 h-10 w-10 border-r-2 border-t-2 border-primary"></div>
        <div class="absolute -bottom-1 -left-1 h-10 w-10 border-b-2 border-l-2 border-primary"></div>
        <div class="absolute -bottom-1 -right-1 h-10 w-10 border-b-2 border-r-2 border-primary"></div>

        <!-- centered label cutout on top edge -->
        <div
          class="absolute -top-3 left-1/2 -translate-x-1/2 bg-background px-4 font-mono text-[10px] tracking-[0.5em] text-primary"
        >
          [ TRANSMISSION · ONLINE ]
        </div>

        <!-- centered handle on bottom edge -->
        <div
          class="absolute -bottom-3 left-1/2 -translate-x-1/2 bg-background px-4 font-mono text-[9px] tracking-[0.4em] text-primary/50"
        >
          v2 / dark / clu
        </div>

        <!-- animated top + bottom sweeping highlights -->
        <div class="absolute inset-x-0 top-0 h-px overflow-hidden">
          <div class="hero-sweep h-full w-1/4 bg-gradient-to-r from-transparent via-primary to-transparent"></div>
        </div>
        <div class="absolute inset-x-0 bottom-0 h-px overflow-hidden">
          <div class="hero-sweep hero-sweep-reverse h-full w-1/4 bg-gradient-to-r from-transparent via-primary to-transparent"></div>
        </div>
      </div>

      <!-- title block -->
      <div class="relative py-10 text-center md:py-14">
        <p
          class="font-mono text-[10px] uppercase tracking-[0.5em] text-foreground/60"
        >
          {hero.kicker}
        </p>

        <h1
          class="mt-6 font-heading font-black uppercase leading-[0.85] tracking-[0.04em] text-foreground"
        >
          <span
            class="block text-5xl md:text-7xl lg:text-8xl"
            style="text-shadow: 0 0 40px color-mix(in oklch, var(--glow) 35%, transparent), 0 0 90px color-mix(in oklch, var(--glow) 18%, transparent);"
          >
            {firstName}
          </span>
          <span
            class="mt-2 block text-6xl text-primary md:text-8xl lg:text-[9rem]"
            style="text-shadow: 0 0 60px color-mix(in oklch, var(--glow) 55%, transparent), 0 0 140px color-mix(in oklch, var(--glow) 30%, transparent);"
          >
            {lastName}
          </span>
        </h1>

        <!-- title underline accents (3 progressively shorter lines) -->
        <div class="mt-8 flex justify-center gap-1">
          <div class="h-px w-16 bg-primary/70"></div>
          <div class="h-px w-8 bg-primary/40"></div>
          <div class="h-px w-3 bg-primary/20"></div>
        </div>

        <p
          class="mx-auto mt-8 max-w-2xl font-mono text-xs uppercase tracking-[0.35em] text-primary/80 md:text-sm"
        >
          {hero.headline}
        </p>
        <p
          class="mx-auto mt-6 max-w-2xl text-base leading-relaxed text-foreground/60 md:text-lg"
        >
          {hero.tagline}
        </p>

        <!-- CTAs in gridcn home style -->
        <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
          <a
            href="/posts/"
            class="group relative overflow-hidden rounded border-2 border-primary bg-primary/15 px-8 py-3 font-mono text-xs font-bold uppercase tracking-widest text-primary transition-all hover:bg-primary hover:text-primary-foreground hover:shadow-[0_0_40px_var(--primary)]"
          >
            <span class="relative z-10">Browse Transmissions</span>
            <span
              aria-hidden="true"
              class="absolute inset-0 -z-0 translate-y-full bg-primary transition-transform duration-300 group-hover:translate-y-0"
            ></span>
          </a>
          <a
            href={githubLink}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded border border-primary/30 bg-transparent px-8 py-3 font-mono text-xs font-bold uppercase tracking-widest text-foreground/70 transition-all hover:border-primary/60 hover:text-primary hover:shadow-[0_0_24px_color-mix(in_oklch,var(--glow)_35%,transparent)]"
          >
            View on GitHub
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- bottom scroll indicator -->
  <div class="absolute inset-x-0 bottom-0 z-10">
    <div class="h-px bg-gradient-to-r from-transparent via-primary/40 to-transparent"></div>
    <div class="flex items-center justify-center gap-6 py-3">
      <div class="h-px w-20 bg-gradient-to-r from-transparent to-primary/40"></div>
      <div
        class="hero-scroll-bounce font-mono text-[9px] uppercase tracking-[0.5em] text-foreground/50"
      >
        ↓ Scroll ↓
      </div>
      <div class="h-px w-20 bg-gradient-to-l from-transparent to-primary/40"></div>
    </div>
  </div>
</section>

<style>
  /* Sweeping border highlight — runs along the top + bottom edges of
     the outer frame. Two copies; the second runs in reverse. */
  @keyframes hero-sweep {
    0%,
    100% {
      transform: translateX(-100%);
    }
    50% {
      transform: translateX(400%);
    }
  }
  .hero-sweep {
    animation: hero-sweep 6s ease-in-out infinite;
  }
  .hero-sweep-reverse {
    animation-direction: reverse;
    animation-delay: -3s;
  }

  @keyframes hero-scroll-bounce {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.5;
    }
    50% {
      transform: translateY(4px);
      opacity: 1;
    }
  }
  .hero-scroll-bounce {
    animation: hero-scroll-bounce 2.4s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-sweep,
    .hero-scroll-bounce {
      animation: none;
    }
  }
</style>
