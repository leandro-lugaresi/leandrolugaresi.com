---
import { getCollection, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import HudCard from '@/components/site/HudCard.astro';
import { social } from '@/data/home';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) =>
    import.meta.env.PROD ? !data.draft : true
  );
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);

const readingTime =
  (remarkPluginFrontmatter as { readingTime?: { text: string } }).readingTime
    ?.text ?? null;

const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
const formattedUpdated = post.data.updatedDate?.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

const githubLink = social.find((s) => s.label === 'GitHub')?.href ?? '#';
---

<Base
  title={post.data.title}
  description={post.data.description}
  ogType="article"
>
  <article class="relative mx-auto max-w-3xl px-6 py-16 md:py-24">
    {/* Breadcrumbs */}
    <nav
      aria-label="Breadcrumb"
      class="mb-8 font-mono text-[10px] uppercase tracking-widest text-foreground/40"
    >
      <ol class="flex flex-wrap items-center gap-2">
        <li><a href="/" class="transition-colors hover:text-primary">Home</a></li>
        <li aria-hidden="true" class="text-foreground/20">/</li>
        <li>
          <a href="/posts/" class="transition-colors hover:text-primary">Posts</a>
        </li>
        <li aria-hidden="true" class="text-foreground/20">/</li>
        <li class="text-foreground/70">{post.data.title}</li>
      </ol>
    </nav>

    {/* Header */}
    <header class="mb-10">
      <p
        class="font-mono text-[10px] uppercase tracking-[0.4em] text-primary/70"
      >
        // Transmission
      </p>
      <h1
        class="mt-4 font-heading text-3xl font-bold uppercase tracking-wide text-foreground md:text-5xl"
      >
        {post.data.title}
      </h1>
      <p class="mt-4 text-base leading-relaxed text-foreground/70 md:text-lg">
        {post.data.description}
      </p>

      <dl
        class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 font-mono text-[10px] uppercase tracking-widest text-foreground/40"
      >
        <div class="flex items-center gap-2">
          <dt class="text-foreground/30">Date</dt>
          <dd class="text-foreground/80">
            <time datetime={post.data.pubDate.toISOString()}>
              {formattedDate}
            </time>
          </dd>
        </div>
        {readingTime && (
          <div class="flex items-center gap-2">
            <dt class="text-foreground/30">Read</dt>
            <dd class="text-foreground/80">{readingTime}</dd>
          </div>
        )}
        {formattedUpdated && (
          <div class="flex items-center gap-2">
            <dt class="text-foreground/30">Updated</dt>
            <dd class="text-foreground/80">
              <time datetime={post.data.updatedDate!.toISOString()}>
                {formattedUpdated}
              </time>
            </dd>
          </div>
        )}
      </dl>

      {post.data.tags.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-2">
          {post.data.tags.map((tag) => (
            <li
              class="rounded border border-primary/30 bg-primary/5 px-2.5 py-1 font-mono text-[10px] uppercase tracking-widest text-primary/80"
            >
              #{tag}
            </li>
          ))}
        </ul>
      )}
    </header>

    {/* Content */}
    <div class="prose-post">
      <Content />
    </div>

    {/* Author box */}
    <HudCard class="mt-16 px-6 py-6">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-5">
        <div
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded border border-primary/40 bg-primary/10 font-heading text-sm font-bold text-primary"
        >
          LL
        </div>
        <div class="flex-1">
          <div
            class="font-mono text-[9px] uppercase tracking-[0.4em] text-primary/70"
          >
            Operator
          </div>
          <p class="mt-1 font-heading text-base font-bold uppercase tracking-wider text-foreground">
            Leandro Lugaresi
          </p>
          <p class="mt-1 text-sm leading-relaxed text-foreground/60">
            Backend & systems engineer. Writing about Go, data pipelines, and
            the Cloudflare playground.
          </p>
        </div>
        <a
          href={githubLink}
          target="_blank"
          rel="noopener noreferrer"
          class="shrink-0 rounded border border-primary/30 px-4 py-2 font-mono text-[10px] uppercase tracking-widest text-foreground/70 transition-all hover:border-primary/60 hover:text-primary"
        >
          GitHub
        </a>
      </div>
    </HudCard>
  </article>
</Base>

<style is:global>
  /* Prose styling for post content. Scoped to .prose-post so it
     doesn't leak into the rest of the site. */
  .prose-post {
    color: color-mix(in oklch, var(--foreground) 75%, transparent);
    font-size: 1rem;
    line-height: 1.75;
  }
  .prose-post > * + * {
    margin-top: 1.25em;
  }
  .prose-post h2,
  .prose-post h3,
  .prose-post h4 {
    color: var(--foreground);
    font-family: var(--font-orbitron), ui-sans-serif, sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-top: 2.5em;
    margin-bottom: 0.5em;
  }
  .prose-post h2 {
    font-size: 1.5rem;
    padding-bottom: 0.4em;
    border-bottom: 1px solid color-mix(in oklch, var(--primary) 15%, transparent);
  }
  .prose-post h3 {
    font-size: 1.25rem;
  }
  .prose-post a {
    color: var(--primary);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklch, var(--primary) 40%, transparent);
    text-underline-offset: 3px;
  }
  .prose-post a:hover {
    text-decoration-color: var(--primary);
  }
  .prose-post strong {
    color: var(--foreground);
    font-weight: 600;
  }
  .prose-post code:not(pre code) {
    background: color-mix(in oklch, var(--primary) 10%, transparent);
    color: var(--primary);
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    font-size: 0.875em;
    padding: 0.15em 0.4em;
    border-radius: 3px;
  }
  .prose-post ul,
  .prose-post ol {
    padding-left: 1.5em;
  }
  .prose-post ul { list-style: disc; }
  .prose-post ol { list-style: decimal; }
  .prose-post li::marker {
    color: color-mix(in oklch, var(--primary) 60%, transparent);
  }
  .prose-post blockquote {
    border-left: 2px solid color-mix(in oklch, var(--primary) 50%, transparent);
    padding-left: 1em;
    color: color-mix(in oklch, var(--foreground) 60%, transparent);
    font-style: italic;
  }
  .prose-post hr {
    border: 0;
    border-top: 1px solid color-mix(in oklch, var(--primary) 15%, transparent);
    margin: 3em 0;
  }
</style>
