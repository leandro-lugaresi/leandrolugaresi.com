---
import HudCard from '@/components/site/HudCard.astro';
import { experience } from '@/data/home';
---

<section
  id="experience"
  aria-labelledby="experience-title"
  class="relative mx-auto mt-24 max-w-6xl px-6"
>
  <div class="mb-8 flex items-end justify-between gap-6">
    <div>
      <p
        class="font-mono text-[10px] uppercase tracking-[0.4em] text-primary/70"
      >
        // 0003
      </p>
      <h2
        id="experience-title"
        class="mt-3 font-heading text-2xl font-bold uppercase tracking-wider text-foreground md:text-3xl"
      >
        Service Record
      </h2>
    </div>
    <p
      class="hidden font-mono text-[10px] uppercase tracking-widest text-foreground/30 md:block"
    >
      {experience.length} postings · 13+ years
    </p>
  </div>

  <ol class="relative space-y-6 border-l border-primary/20 pl-6 md:pl-10">
    {
      experience.map((job, i) => (
        <li class="relative">
          {/* Timeline node */}
          <span
            aria-hidden="true"
            class="absolute -left-[29px] top-6 flex h-3 w-3 items-center justify-center md:-left-[45px]"
          >
            <span class="absolute inline-flex h-full w-full rounded-full bg-primary/30"></span>
            <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-primary"></span>
          </span>

          <HudCard class="px-5 py-5 md:px-7 md:py-6">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div>
                <div class="font-mono text-[9px] uppercase tracking-[0.3em] text-primary/60">
                  Posting {String(i + 1).padStart(2, '0')}
                </div>
                <h3 class="mt-2 font-heading text-lg font-bold uppercase tracking-wider text-foreground md:text-xl">
                  {job.company}
                </h3>
                <div class="mt-1 font-mono text-[10px] uppercase tracking-widest text-primary/80">
                  {job.role}
                </div>
              </div>
              <div class="text-right font-mono text-[10px] uppercase tracking-widest text-foreground/40">
                <div>{job.period}</div>
                <div class="mt-1 text-foreground/30">{job.location}</div>
              </div>
            </div>

            <p class="mt-4 text-sm leading-relaxed text-foreground/70 md:text-base">
              {job.summary}
            </p>

            {job.highlights.length > 0 && (
              <ul class="mt-4 space-y-2 border-t border-primary/10 pt-4">
                {job.highlights.map((h) => (
                  <li class="flex gap-3 text-sm leading-relaxed text-foreground/60">
                    <span
                      aria-hidden="true"
                      class="mt-2 inline-block h-px w-3 shrink-0 bg-primary/60"
                    />
                    <span>{h}</span>
                  </li>
                ))}
              </ul>
            )}
          </HudCard>
        </li>
      ))
    }
  </ol>
</section>
