---
import HudCard from '@/components/site/HudCard.astro';
import { speaking } from '@/data/home';

const dateLabel = (iso: string) =>
  new Date(iso).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: '2-digit',
  });
---

<section
  id="speaking"
  aria-labelledby="speaking-title"
  class="relative mx-auto mt-24 max-w-6xl px-6"
>
  <div class="mb-8 flex items-end justify-between gap-6">
    <div>
      <p
        class="font-mono text-[10px] uppercase tracking-[0.4em] text-primary/70"
      >
        // 0005
      </p>
      <h2
        id="speaking-title"
        class="mt-3 font-heading text-2xl font-bold uppercase tracking-wider text-foreground md:text-3xl"
      >
        Broadcast Log
      </h2>
    </div>
    <p
      class="hidden font-mono text-[10px] uppercase tracking-widest text-foreground/30 md:block"
    >
      {speaking.length} talks · 2016 — 2017
    </p>
  </div>

  <div class="grid gap-3 md:grid-cols-2">
    {
      speaking.map((talk, i) => (
        <HudCard class="px-5 py-5">
          <div class="flex items-center justify-between">
            <span class="font-mono text-[9px] uppercase tracking-[0.3em] text-foreground/30">
              Signal {String(i + 1).padStart(2, '0')}
            </span>
            <time
              datetime={talk.date}
              class="font-mono text-[9px] uppercase tracking-[0.3em] text-primary/60"
            >
              {dateLabel(talk.date)}
            </time>
          </div>

          <h3 class="mt-4 font-heading text-lg font-bold uppercase tracking-wider text-foreground md:text-xl">
            {talk.title}
          </h3>

          <div class="mt-1 font-mono text-[10px] uppercase tracking-widest text-primary/70">
            {talk.event}
          </div>

          <p class="mt-3 text-sm leading-relaxed text-foreground/60">
            {talk.description}
          </p>

          <div class="mt-4 flex flex-wrap items-center gap-2 border-t border-primary/10 pt-4">
            {talk.slidesHref && (
              <a
                href={talk.slidesHref}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded border border-primary/30 bg-primary/10 px-3 py-1.5 font-mono text-[10px] uppercase tracking-widest text-primary transition-colors hover:bg-primary/20"
              >
                ▸ Slides
              </a>
            )}
            {talk.videoHref ? (
              <a
                href={talk.videoHref}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded border border-primary/30 bg-primary/10 px-3 py-1.5 font-mono text-[10px] uppercase tracking-widest text-primary transition-colors hover:bg-primary/20"
              >
                ▸ Video
              </a>
            ) : (
              <span class="rounded border border-primary/10 bg-card/40 px-3 py-1.5 font-mono text-[10px] uppercase tracking-widest text-foreground/30">
                Recording lost
              </span>
            )}
          </div>
        </HudCard>
      ))
    }
  </div>
</section>
