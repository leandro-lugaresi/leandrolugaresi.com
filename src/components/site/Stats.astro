---
import HudCard from "@/components/site/HudCard.astro";
import { AnimatedStatValue } from "@/components/site/AnimatedStatValue";
import { stats } from "@/data/home";
---

<section
  id="stats"
  aria-labelledby="stats-title"
  class="relative mx-auto mt-24 max-w-6xl px-6"
>
  <div class="mb-8 flex items-end justify-between gap-6">
    <div>
      <p class="font-mono text-[10px] uppercase tracking-[0.4em] text-primary/70">
        // 0002
      </p>
      <h2
        id="stats-title"
        class="mt-3 font-heading text-2xl font-bold uppercase tracking-wider text-foreground md:text-3xl"
      >
        Telemetry Snapshot
      </h2>
    </div>
    <p
      class="hidden font-mono text-[10px] uppercase tracking-widest text-foreground/30 md:block"
    >
      {stats.length} readings · cached @ build
    </p>
  </div>

  <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {
      stats.map((stat, i) => (
        <HudCard class="px-5 py-5">
          <div class="flex items-center justify-between">
            <span class="font-mono text-[9px] uppercase tracking-[0.3em] text-foreground/30">
              R{String(i + 1).padStart(2, "0")}
            </span>
          </div>
          <div class="mt-4 flex items-baseline gap-1">
            <span
              class="font-heading text-4xl font-black tracking-tight text-primary tabular-nums md:text-5xl"
              style="text-shadow: 0 0 24px color-mix(in oklch, var(--glow) 35%, transparent);"
            >
              <AnimatedStatValue value={stat.value} client:visible />
            </span>
            {stat.unit && (
              <span class="font-heading text-xl font-bold uppercase text-primary/70 md:text-2xl">
                {stat.unit}
              </span>
            )}
          </div>
          <div class="mt-3 font-mono text-[10px] uppercase tracking-widest text-foreground/70">
            {stat.label}
          </div>
          {stat.sub && (
            <div class="mt-1 font-mono text-[9px] uppercase tracking-widest text-foreground/30">
              {stat.sub}
            </div>
          )}
        </HudCard>
      ))
    }
  </div>
</section>
